# Copy to .env and fill in real values. .env is gitignored.
#
# Generate the passcode hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpass', bcrypt.gensalt()).decode())"
# Then paste the output here.
ADMIN_PASSCODE_HASH=

# A random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Set to 0 to drop the `Secure` flag from the session cookie, which you need
# for local http development. Anything else (including unset) keeps it on, so
# forgetting this in production fails safe rather than leaking the admin cookie
# over plain http.
# COOKIE_SECURE=0

# The club's timezone. Decides which calendar day "today" is — meetings, RSVP
# cutoffs, the read-by countdown. Defaults to America/Chicago. Row timestamps
# stay UTC regardless. Use an IANA name (America/New_York, Europe/London).
# BOOKCLUB_TZ=America/Chicago

# Optional: override Open Library's base URL. Defaults to https://openlibrary.org
# OPENLIBRARY_BASE_URL=https://openlibrary.org

# Path to the SQLite file. Defaults to ./data/bookclub.db
# BOOKCLUB_DB_PATH=./data/bookclub.db
